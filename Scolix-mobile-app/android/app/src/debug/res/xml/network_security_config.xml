<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds DEBUG uniquement (surcharge de src/main/res/xml/network_security_config.xml) :
  autorise le HTTP en clair vers les hôtes du back-end Django local, pour
  `flutter run --dart-define=API_URL=http://10.0.2.2:8000`. Les APK release
  n'embarquent pas ce fichier et n'autorisent aucun trafic en clair.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.65</domain>
    </domain-config>
</network-security-config>
