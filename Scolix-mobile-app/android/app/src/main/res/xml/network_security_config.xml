<?xml version="1.0" encoding="utf-8"?>
<!--
  Release : l'API (https://scolix-1-1.onrender.com) est servie en HTTPS.
  Aucun trafic HTTP en clair n'est autorisé ; HTTPS utilise les autorités de
  certification système. Les hôtes de dev locaux (cleartext) ne sont
  autorisés qu'en debug : voir src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
