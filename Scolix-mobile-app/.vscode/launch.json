{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scolix (Chrome → backend local)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "5000",
        "--dart-define=API_BASE_URL=http://localhost:8000/api"
      ]
    },
    {
      "name": "Scolix (Windows desktop → backend local)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows",
      "args": [
        "--dart-define=API_BASE_URL=http://localhost:8000/api"
      ]
    },
    {
      "name": "Scolix (Android emulator → backend local)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=API_BASE_URL=http://10.0.2.2:8000/api"
      ]
    }
  ]
}
